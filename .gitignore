# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Ignore Jupyter Notebook files anywhere under notebooks/
notebooks/**/*.ipynb

# Explicitly ensure paired python scripts are tracked
!notebooks/**/*.py

# Ignore Jupyter autosave checkpoints
**/.ipynb_checkpoints/

# vi temp
*.swp

# Generated synthetic data and evaluation outputs
data/synthetic/*.csv
outputs/evaluation/*.csv
outputs/evaluation/*.json
notebooks/**/*.md
!notebooks/README.md
notebooks/data/
notebooks/outputs/
tmp/*
!tmp/.gitkeep
